   emitter.Parent = part
   emitter:Emit(50)
   task.delay(duration + 1, function()
    pcall(function() part:Destroy() end)
   end)
  else
   local part = Instance.new("Part")
   part.Anchored = true
   part.CanCollide = false
   part.CanQuery = false
   part.CanTouch = false
   part.Transparency = 1
   part.Size = Vector3.new(0.1, 0.1, 0.1)
   part.CFrame = CFrame.new(pos + Vector3.new(0, 1, 0))
