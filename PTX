-- 9rr UI STYLE  (imported from Project 9rr)
-- ═══════════════════════════════════════════════════════════════════════════
local function Apply9rrUI()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 10)
    if not playerGui then return end

    -- ── Coins frame styling ──
    pcall(function()
        local menuGui = playerGui:FindFirstChild("MenuGui", true)
        local topRight = menuGui and menuGui:FindFirstChild("TopRight", true)
        local coinsFrame = topRight and topRight:FindFirstChild("CoinsFrame")
        local coinsDisplay = coinsFrame and coinsFrame:FindFirstChild("CoinsDisplay")
        local coinImage = coinsDisplay and coinsDisplay:FindFirstChild("CoinImage")
        local coinsText = coinsDisplay and coinsDisplay:FindFirstChild("Coins")
        if coinImage then coinImage.Image = "rbxassetid://17629725719" end
        if coinsText then coinsText.TextColor3 = Color3.new(1, 1, 1) end
        if coinsFrame then
            coinsFrame.BackgroundTransparency = 0.35
            coinsFrame.Position = coinsFrame.Position + UDim2.new(0, 0, 0, 15)
        end
    end)

    -- ── Wait for the in-game MenuGui ──
    local menuGui
    for _ = 1, 40 do
        menuGui = playerGui:FindFirstChild("MenuGui", true)
        if menuGui and menuGui:FindFirstChild("Menu") then break end
        task.wait(0.25)
    end
    if not menuGui then return end
    local menu = menuGui:FindFirstChild("Menu")
    if not menu then return end

    local black = Color3.fromRGB(0, 0, 0)
    local blue = Color3.fromRGB(30, 100, 200)
    local white = Color3.fromRGB(255, 255, 255)
    local cornerRadius = UDim.new(0, 0)

    local function roundCorners(obj)
        local corner = obj:FindFirstChildOfClass("UICorner")
        if corner then
            corner.CornerRadius = cornerRadius
        else
            corner = Instance.new("UICorner")
            corner.CornerRadius = cornerRadius
            corner.Parent = obj
        end
    end

    local function addPurpleBlueGradient(obj, rotation)
        local gradient = obj:FindFirstChildOfClass("UIGradient")
        if not gradient then gradient = Instance.new("UIGradient") end
        gradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, white),
            ColorSequenceKeypoint.new(1, blue)
        }
        gradient.Rotation = rotation or 45
        gradient.Parent = obj
    end

    local tabBarSizeY = 0.9999

    local tabBar = menu:FindFirstChild("TabBar")
    if tabBar then
        tabBar.BackgroundColor3 = black
        tabBar.BackgroundTransparency = 0.28
        tabBar.Size = UDim2.new(tabBar.Size.X.Scale, tabBar.Size.X.Offset, tabBarSizeY, tabBar.Size.Y.Offset)
        roundCorners(tabBar)
    end

    local tabContents = menu:FindFirstChild("TabContents")
    if tabContents then
        for _, frame in ipairs(tabContents:GetChildren()) do
            if frame:IsA("Frame") then
                frame.BackgroundColor3 = black
                frame.BackgroundTransparency = 0.7
                roundCorners(frame)

                local title = frame:FindFirstChild("Title")
                if title then
                    title.BackgroundColor3 = black
                    title.BackgroundTransparency = 0.4
                    roundCorners(title)
                    local currentSize = title.Size
                    title.Size = UDim2.new(currentSize.X.Scale * 0.975, currentSize.X.Offset, currentSize.Y.Scale, currentSize.Y.Offset)
                end

                local sortingTabs = frame:FindFirstChild("SortingTabs")
                if sortingTabs then
                    sortingTabs.BackgroundColor3 = black
                    sortingTabs.BackgroundTransparency = 0.55
                    roundCorners(sortingTabs)
                end

                local contents = frame:FindFirstChild("Contents")
                if contents then
                    contents.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    contents.BackgroundTransparency = 0.55
                    roundCorners(contents)
                    addPurpleBlueGradient(contents, 45)
                    contents.ChildAdded:Connect(function()
                        contents.BackgroundTransparency = 0
                        TweenService:Create(contents, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            BackgroundTransparency = 0.55
                        }):Play()
                    end)
                end

                local favoritesFrame = frame:FindFirstChild("FavoritesFrame")
                if favoritesFrame then
                    favoritesFrame.BackgroundColor3 = black
                    favoritesFrame.BackgroundTransparency = 1
                    roundCorners(favoritesFrame)
                end

                if contents then
                    for _, item in ipairs(contents:GetChildren()) do
                        local fav = item:FindFirstChild("Favorite")
                        if fav and (fav:IsA("ImageLabel") or fav:IsA("ImageButton")) then
                            fav.ImageTransparency = 1
                            fav.BackgroundTransparency = 1
                        end
                    end
                end
            end
        end
    end

    for _, desc in ipairs(menuGui:GetDescendants()) do
        if desc.Name == "MeterFrame" and desc:IsA("GuiObject") then
            desc.BackgroundColor3 = black
            desc.BackgroundTransparency = 0.4
            roundCorners(desc)
        end
    end
end

