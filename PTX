    end})

    WaterGroup:AddLabel("เปิดเพื่อเดินบนน้ำได้")
    WaterGroup:AddLabel("(ไม่มีการเปลี่ยน Water เป็น Terrain)")

    LocalPlayer.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        applyWalkSpeed()
        if enableCFrameSpeed then startCFrameSpeed() end
        if _G.InfiniteJump then
            pcall(function()
                local hum = char:FindFirstChild("Humanoid")
                if hum then hum.JumpPower = _G.InfiniteJumpPower end
            end)
        end
        if spinEnabled then startSpin() end
        if noclipEnabled then startNoclip() end
        if waterWalkEnabled then setOceanCollide(true) end
    end)
