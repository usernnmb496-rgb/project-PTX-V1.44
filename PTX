    local plotColor = inPlot and "#55ff55" or "#ff5555"
    pcall(function() TargetStatInPlot:SetText("<b><font color='#aaaaaa'>In plot:</font></b> <font color='" .. plotColor .. "'>" .. (inPlot and "Yes" or "No") .. "</font>") end)

    local isRagdolled = false
