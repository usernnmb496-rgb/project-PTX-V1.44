local AntiLagGroup = Tabs.Visuals:AddRightGroupbox("Anti Lag", "zap-off")

local AL = { autoClear = false, clearTask = nil, interval = 1, cleared = 0 }

local LAG_OBJECT_NAMES = {
    GrabBeam = true, GrabParts = true, PaintPlayerPart = true,
    ["GrabBeam_Effect"] = true, GrabLine = true,
}

local function clearLagObjects()
    local count = 0
    for _, obj in ipairs(Workspace:GetChildren()) do
        if LAG_OBJECT_NAMES[obj.Name] then
            pcall(function() obj:Destroy() end)
            count = count + 1
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "PaintPlayerPart" then
            pcall(function() obj:Destroy() end)
            count = count + 1
        end
    end
    return count
end

AntiLagGroup:AddButton({
    Text = "Clear Lag Objects (Once)",
    Func = function()
        local n = clearLagObjects()
        Notify("Anti Lag", "Cleared " .. n .. " objects", 3)
    end,
})

AntiLagGroup:AddCheckbox("AutoClearLag", {
    Text = "Auto Clear Lag Objects",
    Default = false,
    Callback = function(Value)
        AL.autoClear = Value
        if Value then
            AL.clearTask = task.spawn(function()
                while AL.autoClear do
                    task.wait(AL.interval)
                    if not AL.autoClear then break end
                    local n = clearLagObjects()
                    AL.cleared = AL.cleared + n
                end
            end)
            Notify("Anti Lag", "Auto Clear ON", 2)
        else
            if AL.clearTask then task.cancel(AL.clearTask) AL.clearTask = nil end
            Notify("Anti Lag", "Auto Clear OFF", 2)
