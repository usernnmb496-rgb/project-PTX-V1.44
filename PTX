    pcall(function()
        local kickAttr = char2:GetAttribute("KickedBy")
        if kickAttr and kickAttr ~= "" then kickText = tostring(kickAttr); kickColor = "#ff5555" end
    end)
    pcall(function() TargetStatKick:SetText("<b><font color='#aaaaaa'>Kick:</font></b> <font color='" .. kickColor .. "'>" .. kickText .. "</font>") end)

